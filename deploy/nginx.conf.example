# nginx in front of url.jp.ai. Works as it is on nginx 1.18 and later.
#
# Before enabling it:
# - The certificate files below must exist, or `nginx -t` fails. Get them first:
#     sudo certbot certonly --nginx -d url.jp.ai --deploy-hook "systemctl reload nginx"
#   `certonly`: plain `certbot --nginx` would write a second url.jp.ai server
#   into the default site, and nginx would then ignore one of the two.
# - 3000 in proxy_pass (twice) must be the PORT the app listens on.
# - On a server without IPv6, delete the two `listen [::]` lines.
# - If a CDN or another proxy stands in front of nginx (Cloudflare's proxy, a
#   load balancer), $remote_addr is that proxy's address: every visitor would
#   share one rate limit and the audit log would name the proxy. Point the DNS
#   name straight at this server, or set up nginx's realip module first.
# - With SELinux enforcing (RHEL, AlmaLinux, Rocky), nginx may not connect to
#   the app until: sudo setsebool -P httpd_can_network_connect 1
#
# The app listens on 127.0.0.1 and trusts X-Real-IP only from this machine.

limit_req_zone $binary_remote_addr zone=urljpai_check:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name url.jp.ai;
    return 301 https://url.jp.ai$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # HTTP/2 is optional here. nginx 1.25.1 and later: add a line `http2 on;`.
    # Older (Ubuntu 24.04 ships 1.24): write `listen 443 ssl http2;` instead.
    server_name url.jp.ai;

    ssl_certificate     /etc/letsencrypt/live/url.jp.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/url.jp.ai/privkey.pem;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    server_tokens off;
    client_max_body_size 8k;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The address nginx saw. Overwrites anything the visitor sent.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_read_timeout 60s;
    }

    # A first, coarse limit before requests reach the app (the app has its own).
    location = /check {
        limit_req zone=urljpai_check burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_read_timeout 60s;
    }
}
